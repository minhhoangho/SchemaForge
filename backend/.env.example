NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/schemaforge
# Prisma CLI only (migrate dev shadow database); not read by the Nest app.
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/schemaforge_shadow
JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-base64-48
CORS_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=true
TRUST_PROXY_HOPS=0
