generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  paid
  shipped

  @@map("order_status")
}

model OrderItems {
  tenantId String @map("tenant_id") @db.Uuid
  orderNumber Int @map("order_number")
  lineNumber Int @map("line_number")
  quantity Int @default(1)
  orders Orders @relation(fields: [tenantId, orderNumber], references: [tenantId, orderNumber], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenantId, orderNumber, lineNumber])
  @@map("order_items")
}

model Orders {
  tenantId String @map("tenant_id") @db.Uuid
  orderNumber Int @map("order_number")
  status OrderStatus @default(pending)
  total Decimal @default(0.00) @db.Decimal(12, 2)
  userId BigInt @map("user_id")
  user Users @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderItems OrderItems[]

  @@id([tenantId, orderNumber])
  @@map("orders")
}

model Tags {
  id String @id @db.Uuid
  userTags UserTags[]

  @@map("tags")
}

model Tenants {
  id String @id @default(uuid()) @db.Uuid
  users Users[]

  @@map("tenants")
}

model UserProfiles {
  userId BigInt @id @map("user_id")
  bio String?
  user Users @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_profiles")
}

model UserTags {
  usersId BigInt @map("users_id")
  tagsId String @map("tags_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  users Users @relation(fields: [usersId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags Tags @relation(fields: [tagsId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([usersId, tagsId])
  @@map("user_tags")
}

model Users {
  id BigInt @id @default(autoincrement())
  tenantId String @map("tenant_id") @db.Uuid
  email String @db.VarChar(255)
  managerId BigInt? @map("manager_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  location Unsupported("geometry(Point, 4326)")?
  tenant Tenants @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  manager Users? @relation("Users_manager", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  orders Orders[]
  userProfiles UserProfiles?
  userTags UserTags[]
  users Users[] @relation("Users_manager")

  @@unique([tenantId, email], map: "users_tenant_id_email_key")
  @@map("users")
}
