            "type": "integer",
            "format": "int32"
          },
          "mã duy nhất": {
            "type": "string",
            "maxLength": 20
          }
        },
        "required": [
          "id",
          "mã duy nhất"
        ]
      },
      "NguoiDung": {
        "type": "object",
        "description": "Người dùng: it's \"quoted\", `ticked` [bracketed] a\\b */ end\n-- ; DROP TABLE x",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "họ tên": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100,
            "description": "trước\u0000sau"
          },
          "USER_ID": {
            "type": "integer",
            "format": "int32"
          },
          "ma": {
            "type": "string"
          },
          "má": {
            "type": "string"
          },
          "ghi chú": {
            "type": "string",
            "maxLength": 50
          }
        },
        "required": [
          "id",
          "họ tên",
          "USER_ID",
          "ma",
          "má",
          "ghi chú"
        ]
      },
      "Order": {
        "type": "object",
