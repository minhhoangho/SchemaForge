{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/verify.sh *)",
      "Bash(.claude/scripts/test-file.sh *)",
      "Bash(.claude/scripts/changed-files.sh *)",
      "Bash(.claude/scripts/review-diff.sh *)",
      "Bash(.claude/scripts/secret-scan.sh *)",
      "Bash(.claude/scripts/worktree-setup.sh *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/session-handoff.sh"
          }
        ]
      }
    ]
  }
}
