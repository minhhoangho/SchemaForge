  "components": {
    "schemas": {
      "OrderStatus": {
        "type": "string",
        "enum": [
          "pending",
          "paid",
          "shipped"
        ]
      },
      "OrderItems": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "order_number": {
            "type": "integer",
            "format": "int32"
          },
          "line_number": {
            "type": "integer",
            "format": "int32"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "tenant_id",
          "order_number",
          "line_number",
          "quantity"
        ]
      },
      "Orders": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "order_number": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "total": {
            "type": "string",
            "pattern": "^-?0*[0-9]{1,10}(\\.[0-9]{1,2})?$"
          },
          "user_id": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)$"
          }
        },
        "required": [
          "tenant_id",
          "order_number",
          "status",
          "total",
          "user_id"
        ]
      },
      "Tags": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "Tenants": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "UserProfiles": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)$"
          },
          "bio": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "user_id",
          "bio"
        ]
      },
      "UserTags": {
        "type": "object",
        "properties": {
          "users_id": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)$"
          },
          "tags_id": {
            "type": "string",
            "format": "uuid"
          },
          "assigned_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "users_id",
          "tags_id",
          "assigned_at"
        ]
      },
      "Users": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)$"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "maxLength": 255
          },
          "manager_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?(0|[1-9][0-9]*)$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "location": {}
        },
        "required": [
          "id",
          "tenant_id",
          "email",
          "manager_id",
          "created_at",
          "location"
        ]
      }
    }
  }
}
