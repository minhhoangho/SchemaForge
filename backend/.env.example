NODE_ENV=development
PORT=3001
# Add credentials as user:password@ before the host when the server needs them.
DATABASE_URL=postgresql://localhost:5432/schemaforge
# Prisma CLI only (migrate dev shadow database); not read by the Nest app.
SHADOW_DATABASE_URL=postgresql://localhost:5432/schemaforge_shadow
JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-base64-48
CORS_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=true
TRUST_PROXY_HOPS=0
# Optional. Get a key from Google AI Studio; never commit a real key.
GEMINI_API_KEY=
# Required when GEMINI_API_KEY is set.
GEMINI_MODEL=gemini-3.5-flash
# Max AI requests per hour across all users; 503 when exhausted.
AI_GLOBAL_REQUESTS_PER_HOUR=1000
