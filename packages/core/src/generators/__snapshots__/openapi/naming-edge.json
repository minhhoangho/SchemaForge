    "schemas": {
      "TrangThaiDon": {
        "type": "string",
        "enum": [
          "chờ xử lý",
          "đã giao",
          "it's \"quoted\"",
          "ma",
          "má",
          "a\\b",
          "*/ end"
        ]
      },
      "Table2faCodes": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 6
          },
          "__proto__": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
